{
  "schemaVersion": 1,
  "id": "ex.cog03.choose_personal_object",
  "code": "COG-03",
  "type": "choose_from_two",
  "title": "Chọn 1 trong 2 hình đồ vật cá nhân",
  "group": "cognition_receptive",
  "phase": 1,
  "configVersion": 1,

  "itemPool": {
    "category": "personal_object",
    "keys": [
      "object.bottle",
      "object.sandal",
      "object.hat",
      "object.backpack",
      "object.towel",
      "object.pillow"
    ],
    "minItems": 2
  },
  "requiredAudio": ["instruction", "praise", "bridge"],

  "response": {
    "detector": "touch_choice",
    "acceptOn": "pointerup",
    "maxMovePx": 24,
    "ignoreFirstMs": 150,
    "hitSlopPx": 24
  },

  "params": {
    "choices": 2,
    "layout": { "minCardAreaRatio": 0.334 },
    "positions": { "strategy": "balanced_shuffle", "maxSameSideRun": 3 },
    "distractor": { "strategy": "random_other_in_pool", "avoidRepeatLast": 1 }
  },

  "timing": {
    "waitBeforeCueMs": 5000,
    "afterCueTimeoutMs": 15000,
    "rewardMaxMs": 1200,
    "cue": { "kind": "raise_correct", "repeatInstruction": true }
  },

  "scheduling": { "trialsPerRound": 5, "newItemRatio": 0.3, "knownMinTrials": 3, "firstTrialKnownItem": true },

  "mastery": {
    "metric": "independent_correct_rate",
    "threshold": 0.8,
    "lastSessions": 5,
    "minTrials": 6
  },

  "reward": {
    "perTrial": ["mascot_nod", "praise_audio", "star_ting"],
    "echoWord": true,
    "onRoundComplete": "party_standard",
    "party": { "showAnimals": "from_round_items", "max": 3 }
  },

  "spoken": {
    "instruction": "Con hãy chỉ vào {label}",
    "praise": "Aaa {label} đây, hoan hô!",
    "bridge": "Đặt 2 đồ thật của bé lên bàn (một là {label}) rồi nói \"Lấy cho ba mẹ {label}\"."
  },


  "bridge": {
    "target": "newest_or_ready_item",
    "promptAudioRole": "bridge",
    "levels": {
      "2": { "guide": "Đưa 2 thẻ giấy in ảnh đồ của bé (một là {label}). Làm mẫu trước: \"Ở đây mẹ có cặp và dép, bây giờ mẹ lấy dép, aaa dép đây, hoan hô\", rồi dùng câu lệnh của cô: \"{instruction}\"." },
      "3": { "guide": "Đặt 2 món đồ thật của bé lên bàn (một là {label}). Nếu bé lúng túng, cầm tay bé lấy đúng món đưa cho ba mẹ rồi vỗ tay khen; dần thả tay. Đổi vị trí hai món rồi yêu cầu lại." },
      "4": { "guide": "Lúc chuẩn bị ra khỏi nhà hoặc dọn đồ, hỏi bé: \"{instruction}\" rồi chờ bé tìm {label}." }
    }
  },

  "sensory": { "noWrongSound": true, "noText": true },

  "confirm": {
    "status": "confirmed",
    "by": "tài liệu bài tập của trung tâm",
    "date": "2026-10-25",
    "fields": ["instruction", "praise", "bridge.levels.2.guide", "bridge.levels.3.guide"]
  }
}
