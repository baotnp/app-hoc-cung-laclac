{
  "schemaVersion": 1,
  "id": "ex.fin02.fetch_object",
  "code": "FIN-02",
  "type": "choose_from_two",
  "title": "Lấy một đồ vật theo yêu cầu",
  "group": "fine_motor",
  "phase": 1,
  "configVersion": 1,

  "itemPool": {
    "category": "personal_object",
    "keys": [
      "object.bottle",
      "object.sandal",
      "object.hat",
      "object.backpack",
      "object.towel",
      "object.pillow"
    ],
    "minItems": 2
  },
  "requiredAudio": ["instruction", "praise", "bridge"],

  "response": {
    "detector": "touch_choice",
    "acceptOn": "pointerup",
    "maxMovePx": 24,
    "ignoreFirstMs": 150,
    "hitSlopPx": 24
  },

  "params": {
    "choices": 2,
    "layout": { "minCardAreaRatio": 0.334 },
    "positions": { "strategy": "balanced_shuffle", "maxSameSideRun": 3 },
    "distractor": { "strategy": "random_other_in_pool", "avoidRepeatLast": 1 }
  },

  "timing": {
    "waitBeforeCueMs": 5000,
    "afterCueTimeoutMs": 15000,
    "rewardMaxMs": 1200,
    "cue": { "kind": "raise_correct", "repeatInstruction": true }
  },

  "scheduling": { "trialsPerRound": 5, "newItemRatio": 0.3, "knownMinTrials": 3, "firstTrialKnownItem": true },

  "mastery": {
    "metric": "independent_correct_rate",
    "threshold": 0.8,
    "lastSessions": 5,
    "minTrials": 6
  },

  "reward": {
    "perTrial": ["mascot_nod", "praise_audio", "star_ting"],
    "echoWord": true,
    "onRoundComplete": "party_standard",
    "party": { "showAnimals": "from_round_items", "max": 3 }
  },

  "spoken": {
    "instruction": "Con hãy lấy {label}",
    "praise": "Hoan hô, con lấy đúng rồi!",
    "bridge": "Đặt {label} ở xa hơn một chút rồi nhờ bé đi lấy."
  },


  "bridge": {
    "target": "newest_or_ready_item",
    "promptAudioRole": "bridge",
    "levels": {
      "2": { "guide": "Đưa 2 thẻ ảnh (một là {label}). Làm mẫu nói \"Lấy {label}\" và thực hiện hành động lấy vật, vài lần với vài đồ vật; rồi để bé chọn thẻ và đi lấy đúng món đó: \"{instruction}\"." },
      "3": { "guide": "Đặt 2 món đồ thật trên bàn (một là {label}). Hỗ trợ bé lấy đúng, cầm tay bé thực hiện vài lần kèm lời \"lấy {label}\", rồi giảm dần hỗ trợ." },
      "4": { "guide": "Trong sinh hoạt hằng ngày, nhờ bé: \"Con hãy lấy {label}\" rồi chờ đợi; khi bé lấy được đồ ở gần thì nhờ lấy đồ ở xa hơn." }
    }
  },

  "sensory": { "noWrongSound": true, "noText": true },

  "confirm": {
    "status": "confirmed",
    "by": "tài liệu bài tập của trung tâm",
    "date": "2026-10-25",
    "fields": ["instruction", "bridge.levels.2.guide", "bridge.levels.3.guide",
               "bridge.levels.4.guide"]
  }
}
